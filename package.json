{
  "name": "safecard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-first, offline emergency information card PWA",
  "scripts": {
    "dev": "node tool/copy-wasm.mjs && vite",
    "build": "node tool/copy-wasm.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:phase0": "PHASE0_BENCH=1 vitest run test/phase0-report.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "argon2id": "^1.0.1",
    "cbor-x": "^1.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zxing-wasm": "^3.1.3"
  }
}
